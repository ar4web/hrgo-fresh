# node:sqlite is a built-in from Node 22.5 onwards. This file used to pin
# node:20-alpine, so the documented `docker compose up --build` produced an
# image that crash-looped on startup with ERR_UNKNOWN_BUILTIN_MODULE.
FROM node:22-alpine

WORKDIR /app
# server/data is excluded by .dockerignore, so no local database (and with it
# the HS256 signing key and every live session hash) is baked into the image.
COPY server/ ./

# The store writes to ./data relative to the module; create it up front and hand
# it to the unprivileged user so the container does not need to run as root.
RUN mkdir -p /app/data && chown -R node:node /app

ENV NODE_ENV=production \
    AUTH_PORT=8080 \
    AUTH_DB_PATH=/app/data/gohr.sqlite

USER node
EXPOSE 8080
CMD ["node", "index.mjs"]
